# ─────────────────────────────────────────────
# App
# ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# ─────────────────────────────────────────────
# Storage
# ─────────────────────────────────────────────
# Drizzle + PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/whatsapp_api
JWT_SECRET=your_jwt_secret_here
STORAGE_MODE=drizzle

# ─────────────────────────────────────────────
# HTTP Client
# ─────────────────────────────────────────────
DEFAULT_PROVIDER_TIMEOUT_MS=10000

# ─────────────────────────────────────────────
# Retry
# ─────────────────────────────────────────────
RETRY_ATTEMPTS=3
RETRY_DELAY_MS=1000

# ─────────────────────────────────────────────
# Meta WhatsApp Cloud API
# ─────────────────────────────────────────────
META_GRAPH_BASE_URL=https://graph.facebook.com
META_API_VERSION=v19.0

# Fill these when using Meta Cloud API directly
META_ACCESS_TOKEN=your_meta_access_token_here
META_PHONE_NUMBER_ID=your_phone_number_id_here
META_VERIFY_TOKEN=your_webhook_verify_token_here
META_APP_SECRET=your_meta_app_secret_here

# ─────────────────────────────────────────────
# BSP / Official Partner Adapter
# ─────────────────────────────────────────────
BSP_BASE_URL=https://your-bsp-provider.com/api
BSP_ACCESS_TOKEN=your_bsp_access_token_here
BSP_VERIFY_TOKEN=your_bsp_verify_token_here
BSP_WEBHOOK_SECRET=your_bsp_webhook_secret_here
