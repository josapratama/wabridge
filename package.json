{
  "name": "wabridge",
  "version": "1.0.0",
  "description": "WhatsApp Multi-Device Bridge & Integration Suite (Monorepo)",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"bun run --cwd apps/backend dev\" \"bun run --cwd apps/frontend dev\"",
    "dev:backend": "bun run --cwd apps/backend dev",
    "dev:frontend": "bun run --cwd apps/frontend dev",
    "build": "bun run --cwd apps/backend build && bun run --cwd apps/frontend build",
    "sync:i18n": "bun run --cwd apps/frontend sync:i18n"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
